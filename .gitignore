# Scraped HTML cache (regenerable, large)
.cache/

# Scheduled-update-check runtime state (mutates every run; not committed config)
library.json
pacing.json
# Atomic-write temp files, if a run is ever killed between mkstemp and os.replace
.library.*.tmp
.pacing.*.tmp
.update_check.lock
logs/

# Kindle-mail credentials (local-only, never committed)
.env

# Generated output
*.epub

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/

# Windows/WSL NTFS zone-identifier metadata (created when files are downloaded via a mounted drive)
*:Zone.Identifier

# OS junk
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
