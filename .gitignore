# Scraped HTML cache (regenerable, large)
.cache/

# Scheduled-update-check runtime state (mutates every run; not committed config)
library.json
pacing.json
# Atomic-write temp files, if a run is ever killed between mkstemp and os.replace
.library.*.tmp
.pacing.*.tmp
.update_check.lock
logs/

# Classification data spine (Stage 0) runtime DB -- mutates every crawl run
dataspine.db
dataspine.db-journal
dataspine.db-wal
dataspine.db-shm

# Debug dump from a failed Novel Updates challenge solve
nu_challenge_debug.html
nu_challenge_debug.png

# SeleniumBase's own runtime lock files (PyAutoGUI/driver-download locks)
downloaded_files/

# Kindle-mail credentials (local-only, never committed)
.env

# Generated output
*.epub

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/

# Windows/WSL NTFS zone-identifier metadata (created when files are downloaded via a mounted drive)
*:Zone.Identifier

# OS junk
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
