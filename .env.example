# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real credentials.
#
# One-time setup: amazon.com/myk -> Preferences -> Personal Document Settings
# -> note your Kindle's @kindle.com address, and add EPUB_MAIL_SMTP_USER
# below to the Approved Personal Document E-mail List (Amazon silently drops
# mail from unapproved senders).
#
# Gmail requires an App Password, not your regular account password.

EPUB_MAIL_SMTP_HOST=smtp.gmail.com
EPUB_MAIL_SMTP_PORT=587
EPUB_MAIL_SMTP_USER=you@gmail.com
EPUB_MAIL_SMTP_PASSWORD=app-password
EPUB_MAIL_KINDLE_ADDR=yourname_XXXX@kindle.com
EPUB_MAIL_ALERT_ADDR=you@gmail.com

# Optional -- uncomment to override defaults:
# EPUB_MAIL_FROM_ADDR=you@gmail.com
# EPUB_MAIL_SMTP_USE_SSL=false
